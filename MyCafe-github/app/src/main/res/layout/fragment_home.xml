<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/text_dis"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="32dp"
        android:background="@color/purple_500"
        android:gravity="center|fill_vertical"
        android:text="@string/text_dis"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_enter" />

    <TextView
        android:id="@+id/text_n1"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="124dp"
        android:background="@color/orange_2"
        android:gravity="center|fill_vertical"
        android:text="@string/text_n1"
        android:textSize="20sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_enter" />

    <TextView
        android:id="@+id/text_n2"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="216dp"
        android:background="@color/orange_2"
        android:gravity="center|fill_vertical"
        android:text="@string/text_n2"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_enter" />

    <TextView
        android:id="@+id/text_n3"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="308dp"
        android:background="@color/orange_2"
        android:gravity="center|fill_vertical"
        android:text="@string/text_n3"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_enter" />

    <Button
        android:id="@+id/bt_enter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="304dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="32dp"
        android:onClick="bottonClick"
        android:text="@string/bt_enter"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/text_dis"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.93"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>