<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pcr.PCRFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_pay"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@color/orange_2"
                android:gravity="center|fill_vertical"
                android:text="@string/text_pay"
                android:textSize="20dp"
                android:textStyle="bold" />

            <ScrollView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/text_payword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:gravity="left"
                    android:text="@string/text_payword"
                    android:textSize="16dp"
                    android:textStyle="bold" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_point"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@color/orange_2"
                android:gravity="center|fill_vertical"
                android:text="@string/text_point"
                android:textSize="20dp"
                android:textStyle="bold" />

            <ScrollView

                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/text_pointword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:gravity="left"
                    android:text="@string/text_pointword"
                    android:textSize="16dp"
                    android:textStyle="bold" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_avalue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@color/orange_2"
                android:gravity="center|fill_vertical"
                android:text="@string/text_avalue"
                android:textSize="20dp"
                android:textStyle="bold" />

            <ScrollView

                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/text_avalueword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:gravity="left"
                    android:text="@string/text_avalueword"
                    android:textSize="16dp"
                    android:textStyle="bold" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>